flowchart TD
    START([Start: User Taps + on Investment Portfolio Screen]) --> FORM[Display Add Investment Form]
    FORM --> TYPE["User Selects Asset Type from 10 Options: Stocks / Cryptocurrency / ETF / Bonds / Real Estate / Commodities / Fixed Deposit / Unit Trust / Options / Others"]
    TYPE --> NAME[User Enters Asset Name]
    NAME --> SYMBOL[User Enters Stock Symbol - Optional for Stocks]
    SYMBOL --> QTY[User Enters Quantity + Purchase Price + Purchase Date]
    QTY --> CALC[Auto-Calculate Total: Quantity x Purchase Price]
    CALC --> NOTES[User Adds Notes - Optional]
    NOTES --> VAL[Client-Side Validation]
    VAL --> VALID{All Valid?}
    VALID -- No --> ERR[Display Error Message]
    ERR --> FORM
    VALID -- Yes --> POST[Send POST Request to /investments]
    POST --> BVAL[Backend Validates Data]
    BVAL --> BVALID{Valid?}
    BVALID -- No --> BERR[Return 400 Error]
    BERR --> ERRDISP[Display Error]
    ERRDISP --> FORM
    BVALID -- Yes --> CREATE[Create Investment Record]
    CREATE --> PRICE[Set CurrentPrice = PurchasePrice]
    PRICE --> PERF[Recalculate Portfolio Performance Metrics]
    PERF --> FIRST{First Investment Ever?}
    FIRST -- Yes --> BADGE1[Award Investment Beginner Badge]
    FIRST -- No --> FIVE
    BADGE1 --> FIVE{5+ Different Asset Types?}
    FIVE -- Yes --> BADGE2[Award Portfolio Builder Badge]
    FIVE -- No --> RESP
    BADGE2 --> RESP[Return Success Response]
    RESP --> DISPLAY[Display Investment Added with Portfolio Summary]
    DISPLAY --> DONE([End])
