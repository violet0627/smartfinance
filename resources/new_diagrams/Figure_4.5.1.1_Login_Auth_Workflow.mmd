flowchart TD
    START([Start: User Taps Sign In]) --> FORM[Display Login Form]
    FORM --> INPUT[User Enters Email + Password]
    INPUT --> VALIDATE[Client-Side Validation]
    VALIDATE --> VALID{All Fields Valid?}
    VALID -- No --> ERR1[Display Validation Error]
    ERR1 --> FORM
    VALID -- Yes --> POST[Send POST Request to /auth/login]
    POST --> FIND[Backend Finds User by Email]
    FIND --> FOUND{User Found?}
    FOUND -- No --> ERR2[Return 401 Unauthorized]
    ERR2 --> CRED[Display Invalid Credentials]
    CRED --> FORM
    FOUND -- Yes --> VERIFY[Verify bcrypt Password Hash]
    VERIFY --> PASS{Password Correct?}
    PASS -- No --> ERR2
    PASS -- Yes --> TFA{2FA Enabled for This User?}

    TFA -- No --> JWT[Generate JWT Access Token]
    JWT --> RETURN1[Return Token + User Profile]
    RETURN1 --> STORE1[Store Token in SecureStorage]
    STORE1 --> DASH([Navigate to Dashboard])

    TFA -- Yes --> TEMP[Return requires_2fa: true + Temporary Token]
    TEMP --> SCREEN2FA[Display TOTP Code Entry Screen]
    SCREEN2FA --> CODE[User Enters 6-Digit Code from Authenticator App]
    CODE --> POST2FA[Send POST to /auth/verify-2fa with temp token + code]
    POST2FA --> CHECKCODE[Backend Validates TOTP Code using pyotp + secret]
    CHECKCODE --> CODEOK{Code Valid?}
    CODEOK -- No --> ERR3[Display Invalid Code Error]
    ERR3 --> SCREEN2FA
    CODEOK -- Yes --> JWT
