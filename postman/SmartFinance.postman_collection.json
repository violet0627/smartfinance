        },
        {
          "name": "Get Portfolio Summary",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
            "url": {"raw": "{{baseUrl}}/investments/user/{{userId}}/portfolio", "host": ["{{baseUrl}}"], "path": ["investments", "user", "{{userId}}", "portfolio"]},
            "description": "Get total portfolio value, profit/loss, asset type breakdown, and top/bottom performers."
          }
        },
        {
