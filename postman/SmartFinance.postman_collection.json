          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{accessToken}}"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPrice\": 9.50,\n  \"notes\": \"Updated notes\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {"raw": "{{baseUrl}}/investments/1", "host": ["{{baseUrl}}"], "path": ["investments", "1"]},
            "description": "Update investment details. Commonly used to update current price."
          }
        },
        {
          "name": "Quick Price Update",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{accessToken}}"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPrice\": 9.80\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {"raw": "{{baseUrl}}/investments/1/update-price", "host": ["{{baseUrl}}"], "path": ["investments", "1", "update-price"]},
            "description": "Quickly update just the current price and get back the new profit/loss calculation."
          }
        },
        {
          "name": "Delete Investment",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
            "url": {"raw": "{{baseUrl}}/investments/1", "host": ["{{baseUrl}}"], "path": ["investments", "1"]},
            "description": "Remove an investment from the portfolio."
          }
        }
      ]
    },

    {
      "name": "🎯 Goals",
      "item": [
        {
          "name": "Create Goal",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{accessToken}}"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"goalName\": \"Emergency Fund\",\n  \"targetAmount\": 10000.00,\n  \"deadline\": \"2026-12-31\",\n  \"description\": \"6 months of expenses\",\n  \"currentAmount\": 0,\n  \"category\": \"Savings\",\n  \"priority\": \"high\"\n}",
