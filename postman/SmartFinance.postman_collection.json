          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
            "url": {"raw": "{{baseUrl}}/investments/user/{{userId}}", "host": ["{{baseUrl}}"], "path": ["investments", "user", "{{userId}}"]},
            "description": "Get all investments for a user."
